# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://syrh:change-me@localhost:5432/syrh
# Only on a test server without HTTPS (docs/deployment.md); defaults to the opposite of DEBUG.
# DJANGO_SECURE_COOKIES=False
# Keys that encrypt the scanned documents (Fernet), comma-separated: the first encrypts,
# all decrypt. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing every key loses every document: keep a copy apart from the backups (docs/deployment.md).
SYRH_DOCUMENT_KEYS=
# Where the encrypted documents are stored; outside any served directory.
# SYRH_DOCUMENT_ROOT=/var/lib/syrh/documents
